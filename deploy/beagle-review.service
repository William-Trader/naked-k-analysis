[Unit]
Description=Beagle weekly review + adaptive weights
After=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/apps/nakedk-dashboard
Environment=PYTHONPATH=/opt/apps/nakedk-dashboard:/opt/apps/beagle-app
Environment=BEAGLE_DB=/opt/apps/nakedk-dashboard/beagle.db
ExecStart=/usr/bin/python3 -m beagle review --config /opt/apps/nakedk-dashboard/config/beagle.json --apply

[Unit]
Description=Beagle weekly review + adaptive weights
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/ubuntu/beagle-app
Environment=PYTHONPATH=/home/ubuntu/nakedk-dashboard:/home/ubuntu/beagle-app
ExecStart=/usr/bin/python3 -m beagle review --config /home/ubuntu/beagle-app/config/beagle.json --apply

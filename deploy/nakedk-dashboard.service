[Unit]
Description=naked-k price-action dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/naked-k-analysis/nakedk-dashboard
Environment=PORT=8080
Environment=PYTHONPATH=/opt/naked-k-analysis/nakedk-dashboard
Environment=BEAGLE_DB=/opt/naked-k-analysis/beagle-app/beagle.db
ExecStart=/usr/bin/python3 dashboard/server.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
